{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepDeck Command Center",
  "version": "0.1.0",
  "identifier": "co.deepdeck.commandcenter",
  "build": {
    "frontendDist": "../dist/esp-frontend",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run build-prod"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "DeepDeck Command Center", "width": 1280, "height": 820, "minWidth": 960, "minHeight": 640, "dragDropEnabled": false, "visible": false, "maximized": true, "center": true }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
